{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "api/cron-scanner.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/cron-scanner",
      "dest": "/api/cron-scanner.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-scanner",
      "schedule": "*/5 * * * *"
    }
  ]
}
